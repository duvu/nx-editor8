# nx-editor8 Environment Configuration Template
# Copy this file to .env and configure with your specific values

# Service Configuration
SERVICE_NAME=nx-editor8
LOG_LEVEL=INFO

# Kafka Configuration (following xProjects patterns)
KAFKA_BOOTSTRAP_SERVERS=10.113.213.1:9094
KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=client
KAFKA_SASL_PASSWORD=client-secret

# Kafka Topics
KAFKA_INPUT_TOPICS=youtube_content,tiktok_content,facebook_content
KAFKA_CONSUMER_GROUP=nx_editor8_consumer
KAFKA_OUTPUT_TOPIC=video_input_topic

# Database Configuration (consistent with EngineX)
DATABASE_URL=postgresql://vubakninh:123456@10.113.213.9:6432/maker8

# LLM Configuration (following EngineX patterns - consistent with x-neews)
LLM_API_BASE=https://litellm.x51.vn/v1
LLM_API_KEY=your_litellm_api_key_here
LLM_MODEL=gpt-3.5-turbo
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=4000
LLM_TEMPERATURE=0.7

# Processing Configuration
BATCH_SIZE=1
MAX_RETRY_ATTEMPTS=3
PROCESSING_TIMEOUT=300

# Content Generation Configuration
MIN_SCENES=3
MAX_SCENES=10
DEFAULT_VIDEO_RESOLUTION=1920x1080
DEFAULT_VIDEO_FPS=30
DEFAULT_TTS_PROVIDER=googletts

# Content Requirements Configuration (NEW: Requirements Verification)
MIN_WORD_COUNT=50
MAX_WORD_COUNT=2000
MIN_CHAR_COUNT=200
MAX_CHAR_COUNT=10000
REQUIRED_CONTENT_FORMAT=text
REQUIRED_LANGUAGE=
MAX_CONTENT_RETRIES=3

# Content Requirements Configuration Options:
# REQUIRED_CONTENT_FORMAT: text|structured
# REQUIRED_LANGUAGE: en|vi|auto (leave empty for auto-detection)
# MAX_CONTENT_RETRIES: 0-10 (number of retry attempts for failed requirements)

# Performance Tuning
KAFKA_CONSUMER_FETCH_MAX_BYTES=10485760
KAFKA_CONSUMER_MAX_PARTITION_FETCH_BYTES=10485760
KAFKA_PRODUCER_MAX_REQUEST_SIZE=10485760